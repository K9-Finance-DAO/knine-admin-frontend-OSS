{
  "name": "knine-finance-widget",
  "version": "1.60.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS='--inspect' node server.mjs",
    "build": "next build",
    "build:analyze": "ANALYZE_BUNDLE=true next build",
    "build:development": "dotenv -e .env.development.local next build",
    "build:public-dev": "dotenv -e .env.development next build",
    "build:production": "dotenv -e .env.production next build",
    "start": "NODE_OPTIONS='-r next-logger' NODE_ENV=production node server.mjs",
    "lint": "eslint --ext ts,tsx,js,mjs .",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "types": "tsc --noEmit",
    "typechain": "typechain --target=ethers-v5 --out-dir ./generated ./abi/*.json",
    "postinstall": "patch-package && husky install && yarn typechain || true",
    "test": "yarn test:e2e",
    "test:unit": "jest",
    "test:e2e": "playwright test"
  },
